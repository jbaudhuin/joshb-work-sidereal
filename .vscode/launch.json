{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Zodiac (CMake)",
            "type": "lldb",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "cwd": "${workspaceFolder}/bin",
            "console": "integratedTerminal",
            "stopOnEntry": true,
            "preLaunchTask": "CMake: Build"
        },
        {
            "name": "Attach to Zodiac",
            "type": "lldb",
            "request": "attach",
            "program": "${workspaceFolder}/bin/zodiac.exe",
            "waitFor": true
        }
    ]
}