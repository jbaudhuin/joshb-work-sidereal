{
    // CMake configuration - machine independent
    "cmake.sourceDirectory": "${workspaceFolder}",
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.options.statusBarVisibility": "visible",
    "cmake.generator": "Ninja",
    "cmake.preferredGenerators": [
        "Ninja",
        "Unix Makefiles"
    ],
    // Configure clangd for better C++ support
    "clangd.arguments": [
        "--background-index",
        "--log=info",
        "--compile-commands-dir=${workspaceFolder}/build",
        "--clang-tidy",
        "--completion-style=detailed",
        "--clang-format-style=file"
    ],
    // Disable the C/C++ extension's IntelliSense to avoid conflicts
    "C_Cpp.intelliSenseEngine": "disabled",
    // clangd configuration
    "clangd.onConfigChanged": "restart",
    "clangd.detectExtensionConflicts": true,
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "[c]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    // Debug configuration - LLDB DAP
    "lldb-dap.showDisassembly": "auto",
    // Qt and CMake integration - let CMake find Qt automatically
    "cmake.configureSettings": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
    },
    // CMake Tools debug configuration  
    "cmake.debugConfig": {
        "cwd": "${workspaceFolder}/bin"
    },
    // clang-format via clangd - uses project .clang-format file automatically
    "editor.formatOnSaveTimeout": 5000,
    "qt-qml.qmlls.traceLsp": "messages"
}