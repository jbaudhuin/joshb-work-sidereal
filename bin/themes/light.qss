/* ============================================================================
   LIGHT THEME - Zodiac Sidereal Astrology Application
   
   Light theme with inverted colors for comfortable daytime viewing.
   Colors are based on property-based theme selector: [theme="light"]
   ============================================================================ */

/* =========================== Color Palette (Light Theme) ===================
   background:       #F5F5F5 (light gray)
   backgroundAlt:    #E8E8E8 (medium-light gray)
   surface:          #D0D0D0 (medium gray)
   textPrimary:      #2C2C2C (dark gray)
   textSecondary:    #404040 (medium-dark)
   textHeading:      #1A1A1A (almost black)
   textBright:       #000000 (black)
   accent1:          #2E7AB8 (darker blue - applying)
   accent2:          #B85D3A (darker salmon - separating)
   highlight:        #DAA520 (darker gold for contrast)
   secondary:        #0088CC (darker cyan)
   border:           #A0A0A0 (medium border)
   warning:          #CC3333 (darker red)
   ========================================================================== */

/* =========================== QDialog / QMessageBox ========================= */

QDialog, QMessageBox {
	background-color: #F5F5F5;
	color: #2C2C2C;
}

QDialog QLabel, QMessageBox QLabel {
	color: #404040;
	background: transparent;
}

QDialog QPushButton, QMessageBox QPushButton {
	background-color: #E8E8E8;
	color: #2C2C2C;
	border: 1px solid #A0A0A0;
	border-radius: 3px;
	padding: 5px 15px;
	min-width: 60px;
}

QDialog QPushButton:hover, QMessageBox QPushButton:hover {
	background-color: #D0D0D0;
	border-color: #2E7AB8;
}

QDialog QPushButton:pressed, QMessageBox QPushButton:pressed {
	background-color: #C0C0C0;
}

QDialog QLineEdit, QDialog QTextEdit, QDialog QPlainTextEdit,
QDialog QSpinBox, QDialog QDoubleSpinBox, QDialog QComboBox {
	background-color: #FFFFFF;
	color: #2C2C2C;
	border: 1px solid #A0A0A0;
	border-radius: 2px;
	padding: 3px;
}

/* =========================== AstroFileEditor =============================== */

AstroFileEditor {
	background-color: #F5F5F5;
	color: #2C2C2C;
}

AstroFileEditor QLabel {
	color: #404040;
	background: transparent;
}

AstroFileEditor QPushButton {
	background-color: #E8E8E8;
	color: #2C2C2C;
	border: 1px solid #A0A0A0;
	border-radius: 3px;
	padding: 5px 15px;
	min-width: 60px;
}

AstroFileEditor QPushButton#calPopupBtn {
	min-width: 0px;
	padding: 2px 4px;
}

AstroFileEditor QPushButton:hover {
	background-color: #D0D0D0;
	border-color: #2E7AB8;
}

AstroFileEditor QPushButton:pressed {
	background-color: #4A90CA;
	border-color: #2E7AB8;
	color: #FFFFFF;
}

AstroFileEditor QLineEdit, AstroFileEditor QTextEdit, AstroFileEditor QPlainTextEdit,
AstroFileEditor QSpinBox, AstroFileEditor QDoubleSpinBox, AstroFileEditor QComboBox {
	background-color: #FFFFFF;
	color: #2C2C2C;
	border: 1px solid #A0A0A0;
	border-radius: 2px;
	padding: 3px;
}

AstroFileEditor QPlainTextEdit {
	background-color: #FFFFFF;
	color: #2C2C2C;
	border: 1px solid #A0A0A0;
	padding: 5px;
	font-family: "Segoe UI", "DejaVu Sans", Arial, sans-serif;
}

AstroFileEditor QDateEdit, AstroFileEditor QDateTimeEdit {
	background-color: #FFFFFF;
	color: #2C2C2C;
	border: 1px solid #A0A0A0;
	border-radius: 2px;
	padding: 3px;
}

AstroFileEditor QListWidget {
	background-color: #FFFFFF;
	color: #2C2C2C;
	border: 1px solid #A0A0A0;
	alternate-background-color: #F8F8F8;
}

AstroFileEditor QListWidget::item:selected {
	background-color: #4A90CA;
	color: #FFFFFF;
}

AstroFileEditor QListWidget::item:hover {
	background-color: #E8E8E8;
}

/* =========================== QTabWidget ==================================== */

QTextBrowser {
	font-family: "Consolas", "Courier New", courier, "DejaVu Sans Mono", "Lucida Console";
	font-size: 9pt;
	color: #000000;
	background-color: #FFFFFF;
	margin: 10px 0 0 10px;
	border: 1px solid #D0D0D0;
}

/* Plain widget specific toolbar */
Plain QToolBar {
	background-color: #F5F5F5;
	border: none;
	spacing: 3px;
	padding: 2px;
}

Plain QToolBar::separator {
	background: #C0C0C0;
	width: 1px;
	margin: 5px;
}

Plain QToolBar QToolButton {
	color: #2C2C2C;
	font-size: 10pt;
	font-weight: normal;
	padding: 3px 8px;
	margin: 2px;
	background-color: #E0E0E0;
	border: 1px solid #B0B0B0;
	border-radius: 3px;
}

Plain QToolBar QToolButton:hover {
	background-color: #D0D0D0;
	border: 1px solid #909090;
}

Plain QToolBar QToolButton:pressed,
Plain QToolBar QToolButton:checked {
	background-color: #5599DD;
	border: 1px solid #3377BB;
	color: #FFFFFF;
	font-weight: bold;
}

Plain QToolBar QPushButton[chartButton="true"] {
	color: #2C2C2C;
	font-size: 10pt;
	padding: 3px 8px;
	margin: 2px;
	background-color: #E0E0E0;
	border: 1px solid #B0B0B0;
	border-radius: 3px;
	min-width: 20px;
	max-width: 30px;
}

Plain QToolBar QPushButton[chartButton="true"]:hover {
	background-color: #D0D0D0;
	border: 1px solid #909090;
}

Plain QToolBar QPushButton[chartButton="true"]:pressed,
Plain QToolBar QPushButton[chartButton="true"]:checked {
	background-color: #5599DD;
	border: 1px solid #3377BB;
	color: #FFFFFF;
	font-weight: bold;
}

Plain QComboBox {
	color: #2C2C2C;
	background-color: #E0E0E0;
	border: 1px solid #B0B0B0;
	border-radius: 3px;
	padding: 4px 8px;
	min-width: 80px;
	max-width: 120px;
	font-size: 10pt;
}

Plain QComboBox:hover {
	background-color: #D0D0D0;
	border: 1px solid #909090;
}

QTabWidget::pane {
	border: 1px solid #A0A0A0;
	background-color: #F5F5F5;
	border-radius: 3px;
	top: -1px;
}

QTabWidget::tab-bar {
	alignment: left;
}

QTabBar {
	background-color: transparent;
}

QTabBar::tab {
	background-color: #D8D8D8;
	color: #2C2C2C;
	border: 1px solid #A0A0A0;
	border-bottom: none;
	border-top-left-radius: 4px;
	border-top-right-radius: 4px;
	padding: 8px 16px;
	margin-right: 2px;
	min-width: 80px;
}

QTabBar::tab:selected {
	background-color: #F5F5F5;
	color: #1A1A1A;
	border-bottom-color: #F5F5F5;
	font-weight: bold;
}

QTabBar::tab:!selected {
	margin-top: 2px;
	background-color: #D8D8D8;
}

QTabBar::tab:hover:!selected {
	background-color: #E8E8E8;
}

QTabBar::tab:hover:selected {
	background-color: #F5F5F5;
}

/* =========================== QToolBar ====================================== */

QToolBar {
	border: 0;
	spacing: 3px;
	padding: 5px;
	border-bottom: #CCCCCC;
	background: #FAFAFA;
}

QToolBar::handle:horizontal {
	image: url("style/handle.png");
	width: 10px;
}

QToolBar::handle:vertical {
	image: url("style/handle_v2.png");
	height: 10px;
}

QToolBar::separator {
	border: 0;
	width: 5px;
}

/* =========================== QToolButton =================================== */

QToolButton {
	font-size: 10px;
	background: #D8D8D8;
	border: 1px solid #A0A0A0;
	border-radius: 6px;
	padding-bottom: 5px;
	min-width: 54px;
	color: #222;
}

QToolButton:hover {
	background: #C0C0C0;
	border-color: #808080;
}

QToolButton:pressed {
	padding-top: 3px;
	padding-left: 3px;
	background: #8899BB;
	color: #FFF;
}

QToolButton:checked {
	padding-top: -1px;
	background: #9988AA;
	color: #FFF;
}

QToolButton::menu-arrow {
	image: url(details/arrow-down.png);
	width: 10px;
	height: 10px;
}

QToolButton::menu-indicator {
	image: url(details/arrow-down.png);
	width: 10px;
	height: 10px;
}

QToolButton::menu-button {
	width: 16px;
	border: none;
	background: transparent;
}

/* Special QToolButton variants */
QToolButton.transit-btn,
QToolButton[objectName="transitBtn"] {
	min-width: 54px;
	font-size: 10px;
}

QToolButton.transit-btn-wide,
QToolButton[objectName="transitBtnWide"] {
	min-width: 70px;
	font-size: 10px;
}

/* =========================== AstroDatabase ================================= */

AstroDatabase {
	background: #F5F5F5;
}

AstroDatabase QLineEdit {
	color: #222;
	background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
								stop: 0.0 #FFFFFF,
								stop: 0.3 #F5F5F5,
								stop: 0.7 #F5F5F5,
								stop: 1.0 #FFFFFF);
	background-image: url("style/find.png");
	background-repeat: 0;
	border: 1px solid #A0A0A0;
	border-radius: 4px;
	padding-left: 16px;
}

AstroDatabase QLineEdit:focus {
	color: #000;
	background-color: #FFFACD;
	border-color: #DAA520;
}

AstroDatabase QPushButton {
	border: 0;
	background: 0;
}

AstroDatabase QPushButton:pressed {
	padding-top: 3px;
	padding-left: 3px;
}

/* =========================== Transits (Events) ============================= */

Transits {
	background: #F5F5F5;
}

Transits QTreeView {
	background: #F5F5F5;
}

Transits QFrame {
	background: #F5F5F5;
}

/* =========================== QTreeView & QListWidget ======================= */

QTreeView {
	color: #2C2C2C;
	alternate-background-color: #E8E8E8;
	background: transparent;
	border: 0;
	min-width: 50px;
}

QHeaderView {
	color: #FFFFFF;
	background-color: #5A6A7A;
	background: #5A6A7A;
	alternate-background-color: #E8E8E8;
	border: 0;
	min-width: 50px;
}

QTreeView::item:hover,
QTreeView::item:selected {
	color: #0066CC;
	font-weight: bold;
}

QListWidget {
	color: #2C2C2C;
	alternate-background-color: #E8E8E8;
	background: transparent;
	border: 0;
	min-width: 50px;
}

QListWidget::item:hover,
QListWidget::item:selected {
	color: #0066CC;
	font-weight: bold;
}

/* =========================== QDockWidget =================================== */

QDockWidget {
	font-weight: bold;
	color: #1A1A1A;
}

QDockWidget::title {
	background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
								stop: 0 #E0E0E0, stop: 1.0 #C8C8C8);
	border: 1px solid #A0A0A0;
	border-top-left-radius: 4px;
	border-top-right-radius: 4px;
	border-bottom: 2px solid #B0B0B0;
	padding: 7px 10px;
	color: #2C2C2C;
}

/* =========================== QTabBar (Tabs) ================================ */

AstroWidget {
	border-top: 1px solid #D0D0D0;
}

QTabBar::tab {
	background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
								stop: 0 #E0E0E0, stop: 1.0 #C8C8C8);
	border: 1px solid #A0A0A0;
	border-bottom: 1px solid #B0B0B0;
	padding: 4px 12px;
	margin-top: 2px;
	color: #2C2C2C;
}

QTabBar::tab:selected {
	background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
								stop: 0 #FFFFFF, stop: 1.0 #F5F5F5);
	border-right-color: #CCCCCC;
	border-bottom-color: #F5F5F5;
	border-top-color: #E0E0E0;
	border-left-color: #E0E0E0;
	color: #000000;
	font-weight: bold;
}

/* =========================== Details Panel ================================= */

Details {
	background: transparent;
}

ExpandWidget QLabel {
	color: #2C2C2C;
	margin: 5px 0 5px 0;
	padding: 0px;
	font: 8pt Verdana, "DejaVu Sans";
}

ExpandWidget>Title {
	padding: 5px;
	font-weight: bold;
	color: #1A1A1A;
	background: #D0D0D0;
	image: url(details/arrow-right.png);
	image-position: left;
	border-top-left-radius: 6px;
	border-top-right-radius: 6px;
}

ExpandWidget>Title:checked {
	image: url(details/arrow-down.png);
}

/* =========================== Form Controls ================================= */

QLabel {
	margin-bottom: 5px;
	margin-right: 3px;
	color: #2C2C2C;
	background: transparent;
	font: 8pt;
}

QRadioButton {
	color: #2C2C2C;
	background: transparent;
	spacing: 5px;
}

QRadioButton::indicator {
	width: 13px;
	height: 13px;
}

QRadioButton::indicator:unchecked {
	border: 1px solid #808080;
	border-radius: 7px;
	background: #FFFFFF;
}

QRadioButton::indicator:checked {
	border: 1px solid #2E7AB8;
	border-radius: 7px;
	background: qradialgradient(
		cx: 0.5, cy: 0.5, radius: 0.6,
		fx: 0.5, fy: 0.5,
		stop: 0 #2E7AB8,
		stop: 0.5 #2E7AB8,
		stop: 1 #FFFFFF
	);
}

/* Planets widget specific radio buttons (styled as buttons) */
Planets QRadioButton {
	background: #E3F0FF;
	border: 2px solid #5599DD;
	border-radius: 3px;
	font-weight: bold;
	color: #2C5F8F;
	padding: 3px 6px 3px 1px;
}

Planets QRadioButton:hover {
	background: #C8E0FF;
	color: #1A3A5F;
}

Planets QRadioButton:checked {
	background: #5599DD;
	color: #FFFFFF;
}

Planets QRadioButton:pressed {
	background: #3377BB;
	padding-left: 7px;
	padding-top: 5px;
}

Planets QRadioButton::indicator {
	width: 0;
	image: none;
}

/* Transits widget specific form controls */
Transits QLineEdit,
Transits QDateEdit {
	border: 1px solid #A0A0A0;
	border-radius: 4px;
	padding: 3px;
	margin-bottom: 3px;
	color: #000000;
	background: #FFFFFF;
	font: 8pt;
}

Transits QComboBox {
	padding: 1px 2px;
	font: 8pt;
	margin-bottom: 0px;
}

Transits QComboBox QLineEdit {
	background: transparent;
	border: none;
}

Transits QComboBox QListView {
	background-color: #FFFFFF;
	color: #2C2C2C;
}

Transits QRadioButton {
	color: #2C2C2C;
	background: transparent;
	spacing: 5px;
}

Transits QRadioButton::indicator {
	width: 13px;
	height: 13px;
}

Transits QRadioButton::indicator:unchecked {
	border: 1px solid #808080;
	border-radius: 7px;
	background: #FFFFFF;
}

Transits QRadioButton::indicator:checked {
	border: 1px solid #2E7AB8;
	border-radius: 7px;
	background: qradialgradient(
		cx: 0.5, cy: 0.5, radius: 0.6,
		fx: 0.5, fy: 0.5,
		stop: 0 #2E7AB8,
		stop: 0.5 #2E7AB8,
		stop: 1 #FFFFFF
	);
}

QLineEdit,
QDateTimeEdit {
	border: 1px solid #A0A0A0;
	border-radius: 4px;
	padding: 3px;
	margin-bottom: 3px;
	color: #000000;
	background: #FFFFFF;
	font: 8pt;
}

QComboBox {
	border: 1px solid #A0A0A0;
	border-radius: 4px;
	padding: 3px;
	margin-bottom: 3px;
	color: #000000;
	background: #FFFFFF;
	font: bold 9pt;
}

QLineEdit:hover,
QDateTimeEdit:hover,
QComboBox:hover {
	background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
			stop: 0.0 #E0E0E0,
			stop: 0.3 #FFFFFF,
			stop: 0.7 #FFFFFF,
			stop: 1.0 #E0E0E0);
	border-color: #808080;
}

QDateTimeEdit:on,
QComboBox:on {
	padding-top: 6px;
	padding-left: 6px;
	background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
			stop: 0.0 #F0F0F0,
			stop: 0.3 #FFFFFF,
			stop: 0.7 #FFFFFF,
			stop: 1.0 #F0F0F0);
}

QComboBox::drop-down {
	subcontrol-origin: padding;
	subcontrol-position: top right;
	width: 15px;
	border: none;
}

QComboBox::down-arrow {
	image: url(details/arrow-down.png);
}

QComboBox::down-arrow:on {
	top: 1px;
	left: 1px;
}

QComboBox QListView {
	background-color: #FFFFFF;
	color: #2C2C2C;
	selection-background-color: #DAA520;
	selection-color: #000000;
}

/* Completer popup (top-level, not a child of QComboBox) */
QListView#completerPopup {
	background-color: #FFFFFF;
	color: #2C2C2C;
}

/* =========================== Tables ======================================== */

QTableWidget {
	background-color: #FFFFFF;
	color: #2C2C2C;
	font: 8pt 'DejaVu Sans', Verdana;
	selection-background-color: rgba(46, 122, 184, 60);
	border: 1px solid #D0D0D0;
}

QTableWidget::item {
	padding: 0px 2px;
	border: none;
}

QTableWidget::item:selected {
	background-color: rgba(46, 122, 184, 100);
	color: #000000;
}

QTableWidget::item:hover {
	background-color: rgba(218, 165, 32, 80);
	color: #000000;
}

QTableWidget::item:alternate {
	background-color: rgba(0, 0, 0, 0.03);
}

QTableWidget::item:alternate:hover {
	background-color: rgba(218, 165, 32, 80);
	color: #000000;
}

QHeaderView::section {
	background-color: #5A6A7A;
	color: #FFFFFF;
	font-weight: bold;
	padding: 2px 4px;
	border: none;
}

/* =========================== Spin Boxes ==================================== */

QSpinBox, QDoubleSpinBox {
	border: 1px solid #A0A0A0;
	border-radius: 3px;
	padding: 2px 4px;
	color: #000000;
	background: #FFFFFF;
	font: 8pt;
	min-width: 60px;
}

QSpinBox:hover, QDoubleSpinBox:hover {
	background: #F5F5F5;
	border-color: #2E7AB8;
}

QSpinBox:focus, QDoubleSpinBox:focus {
	border-color: #2E7AB8;
	background: #F5F5F5;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
	subcontrol-origin: border;
	subcontrol-position: top right;
	width: 16px;
	border-left: 1px solid #A0A0A0;
	background: #E8E8E8;
	border-top-right-radius: 2px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
	subcontrol-origin: border;
	subcontrol-position: bottom right;
	width: 16px;
	border-left: 1px solid #A0A0A0;
	background: #E8E8E8;
	border-bottom-right-radius: 2px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
	background: #D0D0D0;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
	image: url(details/arrow-up.png);
	width: 7px;
	height: 7px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
	image: url(details/arrow-down.png);
	width: 7px;
	height: 7px;
}

/* =========================== Custom Buttons ================================ */

/* General QPushButton styling */
QPushButton {
	background-color: #E8E8E8;
	color: #2C2C2C;
	border: 1px solid #A0A0A0;
	border-radius: 3px;
	padding: 4px 12px;
	font: 8pt;
}

QPushButton:hover {
	background-color: #D0D0D0;
	border-color: #2E7AB8;
}

QPushButton:pressed {
	background-color: #4A90CA;
	border-color: #2E7AB8;
	color: #FFFFFF;
}

QPushButton:disabled {
	background-color: #F0F0F0;
	color: #AAAAAA;
	border-color: #C0C0C0;
}

QPushButton#calPopupBtn {
	min-width: 0px;
	padding: 2px 4px;
}

/* Radix filter button */
QPushButton[radixButton="true"] {
	background-color: #FFFFFF;
	color: #2C2C2C;
	font: 8pt 'DejaVu Sans', Verdana;
	border: 1px solid #A0A0A0;
	border-radius: 3px;
	padding: 4px 8px;
	min-width: 60px;
	text-align: center;
}

QPushButton[radixButton="true"]:hover {
	background-color: rgba(218, 165, 32, 80);
	color: #000000;
}

QPushButton[radixButton="true"]:checked {
	background-color: rgba(218, 165, 32, 180);
	color: #000000;
	font-weight: bold;
	border-color: #B8860B;
}

QPushButton[radixButton="true"]:pressed {
	background-color: rgba(218, 165, 32, 200);
	color: #000000;
}

/* Chart selector buttons [1] and [2] */
QPushButton[chartButton="true"] {
	color: #2C2C2C;
	font-size: 8pt;
	font-weight: normal;
	padding: 4px 8px;
	margin: 2px;
	background-color: #E0E0E0;
	border: 1px solid #A0A0A0;
	border-radius: 3px;
	text-align: center;
	min-width: 20px;
	max-width: 30px;
}

QPushButton[chartButton="true"]:hover {
	background-color: #D0D0D0;
	border: 1px solid #808080;
}

QPushButton[chartButton="true"]:pressed {
	background-color: #4A90CA;
	border: 1px solid #2E7AB8;
	color: #FFFFFF;
}

QPushButton[chartButton="true"]:checked {
	background-color: #4A90CA;
	border: 1px solid #2E7AB8;
	color: #FFFFFF;
	font-weight: bold;
}

/* Date range navigation arrow buttons */
QPushButton[navButton="true"] {
	background-color: #E8E8E8;
	color: #2C2C2C;
	border: 1px solid #A0A0A0;
	border-radius: 3px;
	padding: 2px 4px;
	font-size: 12pt;
	font-weight: bold;
}

QPushButton[navButton="true"]:hover {
	background-color: #D0D0D0;
	border-color: #2E7AB8;
	color: #1A1A1A;
}

QPushButton[navButton="true"]:pressed {
	background-color: #4A90CA;
	border-color: #2E7AB8;
	color: #FFFFFF;
}

/* =========================== AstroWidget =================================== */

AstroWidget QFrame {
	background: transparent;
	border: 0;
}

AstroWidget QLabel {
	font-weight: bold;
	color: #404060;
}

AstroFileInfo QPushButton {
	background: #F5F5F5;
}

/* =========================== AstroFileInfo ================================= */

AstroFileInfo QLabel, AstroFileInfo QPushButton {
	padding: 5px;
	font: 12px "Segoe UI", Tahoma, Arial;
	text-align: left;
}

AstroFileInfo QPushButton {
	color: #000;
}

AstroFileInfo#secondFile QPushButton {
	color: #0088CC;
}

AstroFileInfo QLabel {
	color: #CCCCCC;
	margin: 1px;
}

/* =========================== File Editor (Plain View) ====================== */

QWidget#backSite {
	border: 1px solid #A0A0A0;
	border-radius: 6px;
	padding: 5px;
	background: #FAFAFA;
}

/* =========================== HelpWidget ==================================== */

HelpWidget QLabel {
	color: #404040;
}

HelpWidget QLabel#title {
	color: #1A1A1A;
	font-family: "Segoe UI", "DejaVu Sans", Tahoma;
	font-size: 14px;
	font-weight: bold;
	padding: 0px;
}

HelpWidget QPushButton {
	border: none;
	text-decoration: underline;
	padding-left: 17px;
	margin-left: 7px;
	color: #0088CC;
	background-image: url("style/rmb.png");
	background-repeat: 0;
}

HelpWidget QPushButton:hover {
	color: #2E7AB8;
}

HelpWidget QPushButton:pressed {
	color: #CC3333;
}

/* =========================== QScrollArea =================================== */

QScrollArea {
	background: #F5F5F5;
	border: 0;
	padding: 5px;
	min-width: 150px;
}

/* =========================== QToolTip ====================================== */

QToolTip {
	border: 1px solid #A0A0A0;
	border-radius: 2px;
	background: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, 
								stop:0 #FFFACD, stop:1 #F0E68C);
	color: #2C2C2C;
	font-weight: bold;
}

/* =========================== MainWindow & Dialogs ========================== */

MainWindow {
	background: #F5F5F5;
}

QDialog#about {
	background-color: none;
	border-image: url(style/about.jpg) 0 0 0 0 stretch stretch;
}

QDialog#about QLabel {
	font: 11px Verdana;
	color: #c5d7f2;
	padding: 100px 15px 15px 15px;
}

QDialog#about QPushButton {
	background-color: qlineargradient(spread:pad,
					x1:0, y1:0.551, x2:0, y2:0.107591,
					stop:0 rgba(0, 43, 63, 255),
					stop:1 rgba(0, 89, 109, 255));
	border-width: 0px;
	border-radius: 6px;
	padding: 5px;
	min-height: 36px;
	color: #EEECE1;
}

QDialog#about QPushButton:pressed {
	background-color: qlineargradient(spread:pad,
		x1:0, y1:0.551, x2:0, y2:0.107591,
		stop:0 rgba(63, 63, 63, 255),
		stop:1 rgba(40, 40, 40, 255));
}

QMainWindow::separator:vertical {
	border-left: 1px solid #A0A0A0;
}

QMainWindow::separator:horizontal {
	border-bottom: 1px solid #A0A0A0;
}

/* =========================== Status Bar ==================================== */

QStatusBar {
	background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
								stop: 0 #E8E8E8, stop: 1.0 #D0D0D0);
	border: 0;
	border-top: 1px solid #CCCCCC;
	color: #2C2C2C;
	min-height: 23px;
}

QStatusBar::item {
	border-right: 1px solid #B0B0B0;
}

QStatusBar QComboBox {
	border: 0;
	background: transparent;
	color: #404040;
	padding: 0 5px 0 7px;
	margin: 0 2px 2px 0px;
}

QStatusBar QComboBox:hover {
	color: #1A1A1A;
	background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
								stop: 0.0 transparent,
								stop: 0.9 #C0C0C0,
								stop: 1.0 transparent);
}

QStatusBar QComboBox::drop-down {
	subcontrol-origin: padding;
	subcontrol-position: top right;
	width: 15px;
	border:none;
}

QStatusBar QComboBox::down-arrow {
	image: url(style/arrow-down.png);
}

QStatusBar QComboBox::down-arrow:on {
	top: 1px;
	left: 1px;
}

QStatusBar QComboBox QListView {
	background-color: #FFFFFF;
	color: #2C2C2C;
}
