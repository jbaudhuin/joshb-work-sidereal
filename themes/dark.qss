/* ============================================================================
   DARK THEME - Zodiac Sidereal Astrology Application
   
   This stylesheet consolidates all component styles into a unified dark theme.
   Colors are based on property-based theme selector: [theme="dark"]
   ============================================================================ */

/* =========================== Color Palette (Dark Theme) ====================
   background:       #202020 (dark gray)
   backgroundAlt:    #424242 (medium gray)
   surface:          #717b88 (blue-gray)
   textPrimary:      #b5bfdf (light blue-gray)
   textSecondary:    #d8e4f4 (lighter blue)
   textHeading:      #e9e9e4 (almost white)
   textBright:       #EEEEEE (white)
   accent1:          #71aeec (blue - applying)
   accent2:          #dfb096 (salmon - separating)
   highlight:        #FFD700 (gold/yellow)
   secondary:        #00C0FF (cyan)
   border:           #585F6A (medium border)
   warning:          #ff6666 (red)
   ========================================================================== */

/* =========================== QDialog / QMessageBox ========================= */

QDialog, QMessageBox {
	background-color: #202020;
	color: #b5bfdf;
}

QDialog QLabel, QMessageBox QLabel {
	color: #d8e4f4;
	background: transparent;
}

QDialog QPushButton, QMessageBox QPushButton {
	background-color: #424242;
	color: #d8e4f4;
	border: 1px solid #585F6A;
	border-radius: 3px;
	padding: 5px 15px;
	min-width: 60px;
}

QDialog QPushButton:hover, QMessageBox QPushButton:hover {
	background-color: #717b88;
	border-color: #71aeec;
}

QDialog QPushButton:pressed, QMessageBox QPushButton:pressed {
	background-color: #585F6A;
}

QDialog QLineEdit, QDialog QTextEdit, QDialog QPlainTextEdit,
QDialog QSpinBox, QDialog QDoubleSpinBox, QDialog QComboBox {
	background-color: #424242;
	color: #d8e4f4;
	border: 1px solid #585F6A;
	border-radius: 2px;
	padding: 3px;
}

/* =========================== AstroFileEditor =============================== */

AstroFileEditor {
	background-color: #202020;
	color: #b5bfdf;
}

AstroFileEditor QLabel {
	color: #d8e4f4;
	background: transparent;
}

AstroFileEditor QPushButton {
	background-color: #424242;
	color: #d8e4f4;
	border: 1px solid #585F6A;
	border-radius: 3px;
	padding: 5px 15px;
	min-width: 60px;
}

AstroFileEditor QPushButton:hover {
	background-color: #717b88;
	border-color: #71aeec;
}

AstroFileEditor QPushButton:pressed {
	background-color: #585F6A;
}

AstroFileEditor QLineEdit, AstroFileEditor QTextEdit, AstroFileEditor QPlainTextEdit,
AstroFileEditor QSpinBox, AstroFileEditor QDoubleSpinBox, AstroFileEditor QComboBox {
	background-color: #424242;
	color: #d8e4f4;
	border: 1px solid #585F6A;
	border-radius: 2px;
	padding: 3px;
}

AstroFileEditor QPlainTextEdit {
	background-color: #2d2d30;
	color: #d8e4f4;
	border: 1px solid #585F6A;
	padding: 5px;
	font-family: "Segoe UI", "DejaVu Sans", Arial, sans-serif;
}

AstroFileEditor QDateEdit, AstroFileEditor QDateTimeEdit {
	background-color: #424242;
	color: #d8e4f4;
	border: 1px solid #585F6A;
	border-radius: 2px;
	padding: 3px;
}

AstroFileEditor QListWidget {
	background-color: #2d2d30;
	color: #d8e4f4;
	border: 1px solid #585F6A;
	alternate-background-color: #323235;
}

AstroFileEditor QListWidget::item:selected {
	background-color: #5399CA;
	color: #FFFFFF;
}

AstroFileEditor QListWidget::item:hover {
	background-color: #4d4d50;
}

/* =========================== QTabWidget ==================================== */

QTextBrowser {
	font-family: "Consolas", "Courier New", courier, "DejaVu Sans Mono", "Lucida Console";
	font-size: 9pt;
	color: #E0E0E0;
	background-color: #202020;
	margin: 10px 0 0 10px;
}

/* Plain widget specific toolbar */
Plain QToolBar {
	background-color: #2d2d30;
	border: none;
	spacing: 3px;
	padding: 2px;
}

Plain QToolBar::separator {
	background: #555555;
	width: 1px;
	margin: 5px;
}

Plain QToolBar QToolButton {
	color: #e9e9e4;
	font-size: 10pt;
	font-weight: normal;
	padding: 3px 8px;
	margin: 2px;
	background-color: #3d3d40;
	border: 1px solid #555555;
	border-radius: 3px;
}

Plain QToolBar QToolButton:hover {
	background-color: #4d4d50;
	border: 1px solid #6a6a6f;
}

Plain QToolBar QToolButton:pressed,
Plain QToolBar QToolButton:checked {
	background-color: #5399CA;
	border: 1px solid #73B9EA;
	color: #ffffff;
	font-weight: bold;
}

Plain QToolBar QPushButton[chartButton="true"] {
	color: #e9e9e4;
	font-size: 10pt;
	padding: 3px 8px;
	margin: 2px;
	background-color: #3d3d40;
	border: 1px solid #555555;
	border-radius: 3px;
	min-width: 20px;
	max-width: 30px;
}

Plain QToolBar QPushButton[chartButton="true"]:hover {
	background-color: #4d4d50;
	border: 1px solid #6a6a6f;
}

Plain QToolBar QPushButton[chartButton="true"]:pressed,
Plain QToolBar QPushButton[chartButton="true"]:checked {
	background-color: #5399CA;
	border: 1px solid #73B9EA;
	color: #ffffff;
	font-weight: bold;
}

Plain QComboBox {
	color: #e9e9e4;
	background-color: #3d3d40;
	border: 1px solid #555555;
	border-radius: 3px;
	padding: 4px 8px;
	min-width: 80px;
	max-width: 120px;
	font-size: 10pt;
}

Plain QComboBox:hover {
	background-color: #4d4d50;
	border: 1px solid #6a6a6f;
}

QTabWidget::pane {
	border: 1px solid #585F6A;
	background-color: #202020;
	border-radius: 3px;
	top: -1px;
}

QTabWidget::tab-bar {
	alignment: left;
}

QTabBar {
	background-color: transparent;
}

QTabBar::tab {
	background-color: #2a2a2a;
	color: #b5bfdf;
	border: 1px solid #585F6A;
	border-bottom: none;
	border-top-left-radius: 4px;
	border-top-right-radius: 4px;
	padding: 8px 16px;
	margin-right: 2px;
	min-width: 80px;
}

QTabBar::tab:selected {
	background-color: #202020;
	color: #a0aac8;
	border-bottom-color: #202020;
	font-weight: bold;
}

QTabBar::tab:!selected {
	margin-top: 2px;
	background-color: #2a2a2a;
}

QTabBar::tab:hover:!selected {
	background-color: #424242;
}

QTabBar::tab:hover:selected {
	background-color: #202020;
	color: #d8e4f4;
}

/* =========================== QToolBar ====================================== */

QToolBar {
	border: 0;
	spacing: 3px;
	padding: 5px;
	border-bottom: #d9d9d9;
}

QToolBar::handle:horizontal {
	image: url("style/handle.png");
	width: 10px;
}

QToolBar::handle:vertical {
	image: url("style/handle_v2.png");
	height: 10px;
}

QToolBar::separator {
	border: 0;
	width: 5px;
}

/* =========================== QToolButton =================================== */

QToolButton {
	font-size: 10px;
	background: #4f4f4f;
	border: 1px solid #4f4f4f;
	border-radius: 6px;
	padding-bottom: 5px;
	min-width: 54px;
	color: #EEE;
}

QToolButton:hover {
	background: #888;
}

QToolButton:pressed {
	padding-top: 3px;
	padding-left: 3px;
	background: #77A;
}

QToolButton:checked {
	padding-top: -1px;
	background: #998;
}

QToolButton::menu-arrow {
	image: url(details/arrow-down.png);
	width: 10px;
	height: 10px;
}

QToolButton::menu-indicator {
	image: url(details/arrow-down.png);
	width: 10px;
	height: 10px;
}

QToolButton::menu-button {
	width: 16px;
	border: none;
	background: transparent;
}

/* Special QToolButton variants - to be assigned via class property */
QToolButton.transit-btn,
QToolButton[objectName="transitBtn"] {
	min-width: 54px;
	font-size: 10px;
}

QToolButton.transit-btn-wide,
QToolButton[objectName="transitBtnWide"] {
	min-width: 70px;
	font-size: 10px;
}

/* =========================== AstroDatabase ================================= */

AstroDatabase {
	background: #202020;
}

AstroDatabase QLineEdit {
	color: #EEE;
	background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
								stop: 0.0 #424242,
								stop: 0.3 #525252,
								stop: 0.7 #525252,
								stop: 1.0 #424242);
	background-image: url("style/find.png");
	background-repeat: 0;
	border: 1px solid #585F6A;
	border-radius: 4px;
	padding-left: 16px;
}

AstroDatabase QLineEdit:focus {
	color: #000;
	background-color: #DDD;
}

AstroDatabase QPushButton {
	border: 0;
	background: 0;
}

AstroDatabase QPushButton:pressed {
	padding-top: 3px;
	padding-left: 3px;
}

/* =========================== Transits (Events) ============================= */

Transits {
	background: #202020;
}

Transits QTreeView {
	background: #202020;
}

Transits QFrame {
	background: #202020;
}

/* =========================== QTreeView & QListWidget ======================= */

QTreeView {
	color: #b5bfdf;
	alternate-background-color: #424242;
	background: transparent;
	border: 0;
	min-width: 50px;
}

QHeaderView {
	color: black;
	background-color: #717b88;
	background: #717b88;
	alternate-background-color: #424242;
	border: 0;
	min-width: 50px;
}

QTreeView::item:hover,
QTreeView::item:selected {
	color: yellow;
}

QListWidget {
	color: #b5bfdf;
	alternate-background-color: #424242;
	background: transparent;
	border: 0;
	min-width: 50px;
}

QListWidget::item:hover,
QListWidget::item:selected {
	color: yellow;
}

/* =========================== QDockWidget =================================== */

QDockWidget {
	font-weight: bold;
	color: #d8e4f4;
}

QDockWidget::title {
	background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
								stop: 0 #9F9F9F, stop: 1.0 #7F7F7F);
	border: 1px solid #525252;
	border-top-left-radius: 4px;
	border-top-right-radius: 4px;
	border-bottom: 2px solid #6C6C6C;
	padding: 7px 10px;
}

/* =========================== QTabBar (Tabs) ================================ */

AstroWidget {
	border-top: 1px solid #202020;
}

QTabBar::tab {
	background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
								stop: 0 #9F9F9F, stop: 1.0 #7F7F7F);
	border: 1px solid #525252;
	border-bottom: 1px solid #404040;
	padding: 4px 12px;
	margin-top: 2px;
}

QTabBar::tab:selected {
	background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
								stop: 0 #f8f8f8, stop: 1.0 #dcdfe4);
	border-right-color: #CCCCCC;
	border-bottom-color: #dcdfe4;
	border-top-color: #FCFCFD;
	border-left-color: #FAFCFF;
}

/* =========================== Details Panel ================================= */

Details {
	background: transparent;
}

ExpandWidget QLabel {
	color: #b5bfdf;
	margin: 5px 0 5px 0;
	padding: 0px;
	font: 8pt Verdana, "DejaVu Sans";
}

ExpandWidget>Title {
	padding: 5px;
	font-weight: bold;
	color: #d8e4f4;
	background: #717b88;
	image: url(details/arrow-right.png);
	image-position: left;
	border-top-left-radius: 6px;
	border-top-right-radius: 6px;
}

ExpandWidget>Title:checked {
	image: url(details/arrow-down.png);
}

/* =========================== Form Controls ================================= */

QLabel {
	margin-bottom: 5px;
	margin-right: 3px;
	color: #EEEEEE;
	background: transparent;
	font: 8pt;
}

QRadioButton {
	color: #d8e4f4;
	background: transparent;
	spacing: 5px;
}

QRadioButton::indicator {
	width: 13px;
	height: 13px;
}

QRadioButton::indicator:unchecked {
	border: 1px solid #585F6A;
	border-radius: 7px;
	background: #424242;
}

QRadioButton::indicator:checked {
	border: 1px solid #71aeec;
	border-radius: 7px;
	background: qradialgradient(
		cx: 0.5, cy: 0.5, radius: 0.6,
		fx: 0.5, fy: 0.5,
		stop: 0 #71aeec,
		stop: 0.5 #71aeec,
		stop: 1 #424242
	);
}

/* Planets widget specific radio buttons (styled as buttons) */
Planets QRadioButton {
	background: #295c98;
	border: 2px solid #2171d2;
	border-radius: 3px;
	font-weight: bold;
	color: #a5afcf;
	padding: 3px 6px 3px 1px;
}

Planets QRadioButton:hover {
	background: #5399CA;
	color: #DDD;
}

Planets QRadioButton:checked {
	background: #00c0ff;
	color: #003648;
}

Planets QRadioButton:pressed {
	background: #00A9E0;
	padding-left: 7px;
	padding-top: 5px;
}

Planets QRadioButton::indicator {
	width: 0;
	image: none;
}

/* Transits widget specific form controls */
Transits QLineEdit,
Transits QDateEdit {
	border: 1px solid #585F6A;
	border-radius: 4px;
	padding: 3px;
	margin-bottom: 3px;
	color: #EEEEEE;
	background: #424242;
	font: 8pt;
}

Transits QRadioButton {
	color: #e9e9e4;
	background: transparent;
	spacing: 5px;
}

Transits QRadioButton::indicator {
	width: 13px;
	height: 13px;
}

Transits QRadioButton::indicator:unchecked {
	border: 1px solid #808080;
	border-radius: 7px;
	background: #424242;
}

Transits QRadioButton::indicator:checked {
	border: 1px solid #71aeec;
	border-radius: 7px;
	background: qradialgradient(
		cx: 0.5, cy: 0.5, radius: 0.6,
		fx: 0.5, fy: 0.5,
		stop: 0 #71aeec,
		stop: 0.5 #71aeec,
		stop: 1 #424242
	);
}

QLineEdit,
QDateTimeEdit {
	border: 1px solid #585F6A;
	border-radius: 4px;
	padding: 3px;
	margin-bottom: 3px;
	color: #EEEEEE;
	background: #424242;
	font: 8pt;
}

QComboBox {
	border: 1px solid #585F6A;
	border-radius: 4px;
	padding: 3px;
	margin-bottom: 3px;
	color: #EEEEEE;
	background: #424242;
	font: bold 9pt;
}

QLineEdit:hover,
QDateTimeEdit:hover,
QComboBox:hover {
	background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
			stop: 0.0 #585F6A,
			stop: 0.3 #424242,
			stop: 0.7 #424242,
			stop: 1.0 #585F6A);
}

QDateTimeEdit:on,
QComboBox:on {
	padding-top: 6px;
	padding-left: 6px;
	background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
			stop: 0.0 #323232,
			stop: 0.3 #424242,
			stop: 0.7 #424242,
			stop: 1.0 #323232);
}

QComboBox::drop-down {
	subcontrol-origin: padding;
	subcontrol-position: top right;
	width: 15px;
	border: none;
}

QComboBox::down-arrow {
	image: url(details/arrow-down.png);
}

QComboBox::down-arrow:on {
	top: 1px;
	left: 1px;
}

QComboBox QListView {
	background-color: #383838;
	color: #EEEEEE;
}

/* =========================== Tables ======================================== */

QTableWidget {
	background-color: #202020;
	color: #b5bfdf;
	font: 8pt 'DejaVu Sans', Verdana;
	selection-background-color: rgba(113, 174, 236, 100);
	border: none;
}

QTableWidget::item {
	padding: 0px 2px;
	border: none;
}

QTableWidget::item:selected {
	background-color: rgba(113, 174, 236, 150);
	color: #EEEEEE;
}

QTableWidget::item:hover {
	background-color: rgba(181, 191, 223, 120);
	color: #EEEEEE;
}

QTableWidget::item:alternate {
	background-color: rgba(255, 255, 255, 0.05);
}

QTableWidget::item:alternate:hover {
	background-color: rgba(181, 191, 223, 120);
	color: #EEEEEE;
}

QHeaderView::section {
	background-color: #717b88;
	color: #d8e4f4;
	font-weight: bold;
	padding: 2px 4px;
	border: none;
}

/* =========================== Spin Boxes ==================================== */

QSpinBox, QDoubleSpinBox {
	border: 1px solid #585F6A;
	border-radius: 3px;
	padding: 2px 4px;
	color: #EEEEEE;
	background: #424242;
	font: 8pt;
	min-width: 60px;
}

QSpinBox:hover, QDoubleSpinBox:hover {
	background: #4d4d50;
	border-color: #71aeec;
}

QSpinBox:focus, QDoubleSpinBox:focus {
	border-color: #71aeec;
	background: #4d4d50;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
	subcontrol-origin: border;
	subcontrol-position: top right;
	width: 16px;
	border-left: 1px solid #585F6A;
	background: #3d3d40;
	border-top-right-radius: 2px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
	subcontrol-origin: border;
	subcontrol-position: bottom right;
	width: 16px;
	border-left: 1px solid #585F6A;
	background: #3d3d40;
	border-bottom-right-radius: 2px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
	background: #4d4d50;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
	image: url(details/arrow-up.png);
	width: 7px;
	height: 7px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
	image: url(details/arrow-down.png);
	width: 7px;
	height: 7px;
}

/* =========================== Custom Buttons ================================ */

/* General QPushButton styling */
QPushButton {
	background-color: #424242;
	color: #d8e4f4;
	border: 1px solid #585F6A;
	border-radius: 3px;
	padding: 4px 12px;
	font: 8pt;
}

QPushButton:hover {
	background-color: #4d4d50;
	border-color: #71aeec;
}

QPushButton:pressed {
	background-color: #5399CA;
	border-color: #73B9EA;
}

QPushButton:disabled {
	background-color: #323232;
	color: #666666;
	border-color: #404040;
}

/* Radix filter button - styled like table cells */
QPushButton[radixButton="true"] {
	background-color: #202020;
	color: #b5bfdf;
	font: 8pt 'DejaVu Sans', Verdana;
	border: 1px solid #585F6A;
	border-radius: 3px;
	padding: 4px 8px;
	min-width: 60px;
	text-align: center;
}

QPushButton[radixButton="true"]:hover {
	background-color: rgba(181, 191, 223, 120);
	color: #EEEEEE;
}

QPushButton[radixButton="true"]:checked {
	background-color: rgba(255, 215, 0, 200);
	color: #000000;
	font-weight: bold;
}

QPushButton[radixButton="true"]:pressed {
	background-color: rgba(255, 215, 0, 220);
	color: #000000;
}

/* Chart selector buttons [1] and [2] */
QPushButton[chartButton="true"] {
	color: #e9e9e4;
	font-size: 8pt;
	font-weight: normal;
	padding: 4px 8px;
	margin: 2px;
	background-color: #3d3d40;
	border: 1px solid #555555;
	border-radius: 3px;
	text-align: center;
	min-width: 20px;
	max-width: 30px;
}

QPushButton[chartButton="true"]:hover {
	background-color: #4d4d50;
	border: 1px solid #6a6a6f;
}

QPushButton[chartButton="true"]:pressed {
	background-color: #5399CA;
	border: 1px solid #73B9EA;
}

QPushButton[chartButton="true"]:checked {
	background-color: #5399CA;
	border: 1px solid #73B9EA;
	color: #ffffff;
	font-weight: bold;
}

/* Date range navigation arrow buttons */
QPushButton[navButton="true"] {
	background-color: #424242;
	color: #d8e4f4;
	border: 1px solid #585F6A;
	border-radius: 3px;
	padding: 2px 4px;
	font-size: 12pt;
	font-weight: bold;
}

QPushButton[navButton="true"]:hover {
	background-color: #4d4d50;
	border-color: #71aeec;
	color: #EEEEEE;
}

QPushButton[navButton="true"]:pressed {
	background-color: #5399CA;
	border-color: #73B9EA;
	color: #FFFFFF;
}

/* =========================== AstroWidget =================================== */

AstroWidget QFrame {
	background: transparent;
	border: 0;
}

AstroWidget QLabel {
	font-weight: bold;
	color: #a5afcf;
}

AstroFileInfo QPushButton {
	background: #202020;
}

/* =========================== AstroFileInfo ================================= */

AstroFileInfo QLabel, AstroFileInfo QPushButton {
	padding: 5px;
	font: 12px "Segoe UI", Tahoma, Arial;
	text-align: left;
}

AstroFileInfo QPushButton {
	color: #FFF;
}

AstroFileInfo#secondFile QPushButton {
	color: #00C0FF;
}

AstroFileInfo QLabel {
	color: #000;
	margin: 1px;
}

/* =========================== File Editor (Plain View) ====================== */

QWidget#backSite {
	border: 1px solid #A0A0A0;
	border-radius: 6px;
	padding: 5px;
}

/* =========================== HelpWidget ==================================== */

HelpWidget QLabel {
	color: #CCC;
}

HelpWidget QLabel#title {
	color: #DDD;
	font-family: "Segoe UI", "DejaVu Sans", Tahoma;
	font-size: 14px;
	font-weight: bold;
	padding: 0px;
}

HelpWidget QPushButton {
	border: none;
	text-decoration: underline;
	padding-left: 17px;
	margin-left: 7px;
	color: #00C0FF;
	background-image: url("style/rmb.png");
	background-repeat: 0;
}

HelpWidget QPushButton:hover {
	color: #E7E2C8;
}

HelpWidget QPushButton:pressed {
	color: #FF0000;
}

/* =========================== QScrollArea =================================== */

QScrollArea {
	background: #202020;
	border: 0;
	padding: 5px;
	min-width: 150px;
}

/* =========================== QToolTip ====================================== */

QToolTip {
	border: 1px solid #383838;
	border-radius: 2px;
	background: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, 
								stop:0 #363636, stop:1 #171717);
	color: #e2e1c3;
	font-weight: bold;
}

/* =========================== MainWindow & Dialogs ========================== */

MainWindow {
	/* Background set via paintEvent in C++ code */
}

QDialog#about {
	/* Background set via paintEvent in C++ code */
}

QDialog#about QLabel {
	font: 11px Verdana;
	color: #c5d7f2;
	padding: 100px 15px 15px 15px;
}

QDialog#about QPushButton {
	background-color: qlineargradient(spread:pad,
					x1:0, y1:0.551, x2:0, y2:0.107591,
					stop:0 rgba(0, 43, 63, 255),
					stop:1 rgba(0, 89, 109, 255));
	border-width: 0px;
	border-radius: 6px;
	padding: 5px;
	min-height: 36px;
	color: #EEECE1;
}

QDialog#about QPushButton:pressed {
	background-color: qlineargradient(spread:pad,
		x1:0, y1:0.551, x2:0, y2:0.107591,
		stop:0 rgba(63, 63, 63, 255),
		stop:1 rgba(40, 40, 40, 255));
}

QMainWindow::separator:vertical {
	border-left: 1px solid #717b88;
}

QMainWindow::separator:horizontal {
	border-bottom: 1px solid #717b88;
}

/* =========================== Status Bar ==================================== */

QStatusBar {
	background: url(style/statusbar.png) repeat-X;
	border: 0;
	color: #ECECEC;
	min-height: 23px;
}

QStatusBar::item {
	border-right: 1px groove #4f4f4f;
}

QStatusBar QComboBox {
	border: 0;
	background: transparent;
	color: #BBB;
	padding: 0 5px 0 7px;
	margin: 0 2px 2px 0px;
}

QStatusBar QComboBox:hover {
	color: #EEE;
	background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
								stop: 0.0 transparent,
								stop: 0.9 #4c525c,
								stop: 1.0 transparent);
}

QStatusBar QComboBox::drop-down {
	subcontrol-origin: padding;
	subcontrol-position: top right;
	width: 15px;
	border:none;
}

QStatusBar QComboBox::down-arrow {
	image: url(style/arrow-down.png);
}

QStatusBar QComboBox::down-arrow:on {
	top: 1px;
	left: 1px;
}

QStatusBar QComboBox QListView {
	background-color: #383838;
	color: #EEEEEE;
}
